DB_HOST=localhost
DB_PORT=3306
DB_NAME=jachwi_sunbae
DB_USERNAME=jachwi_sunbae
DB_PASSWORD=local_password
DB_ROOT_PASSWORD=local_root_password
DB_SSL_MODE=DISABLED
# 로컬 전용 예시 값. dev·prod는 openssl rand -base64 32 로 만든 값을 쓴다.
JWT_SECRET=local-demo-jwt-secret-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
PHOTO_STORAGE_ENDPOINT=http://localhost:9000
PHOTO_STORAGE_REGION=us-east-1
PHOTO_STORAGE_BUCKET=jachwi-sunbae-photos
PHOTO_STORAGE_KEY_PREFIX=
PHOTO_STORAGE_ACCESS_KEY=local-photo-access-key
PHOTO_STORAGE_SECRET_KEY=local-photo-secret-key
PHOTO_STORAGE_PORT=9000
PHOTO_STORAGE_CONSOLE_PORT=9001
MAP_PROVIDER_MODE=demo
MAP_NEARBY_PROVIDER=demo
KAKAO_REST_API_KEY=
JUSO_CONFIRM_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
MAP_CONNECT_TIMEOUT_MILLIS=2000
MAP_READ_TIMEOUT_MILLIS=5000
KMA_API_KEY=
WEATHER_INITIAL_LOAD_ENABLED=false
WEATHER_COLLECTION_ENABLED=false
WEATHER_CLEANUP_ENABLED=false
WEATHER_NOTIFICATION_ENABLED=false
# 실제 POP/PCP/SNO 비0 값·의미를 검증한 뒤에만 변경
WEATHER_PRECIPITATION_CONTRACT_VERIFIED=false
WEATHER_FIREBASE_PROJECT_ID=
# 알림 ON에서 파일 기반 ADC를 쓸 때만 저장소 밖 경로를 지정
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/service-account.json
# 실제 공개 지연을 측정하기 전의 초기 가정
WEATHER_PUBLICATION_DELAY_MINUTES=15
DEPLOYMENT_ENVIRONMENT=local
LOG_PATH=./logs
