[Unit]
Description=Jachwi Sunbae backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=jachwi
Group=jachwi

# systemd가 root 권한으로 읽은 뒤 User로 내려간다. 따라서 이 파일은 0600 root:root으로 두고
# 애플리케이션 계정에 읽기 권한을 주지 않는다. 운영 비밀이 들어 있다.
EnvironmentFile=/etc/jachwi-sunbae/app.env

# 애플리케이션이 80 을 듣는다. 비루트 계정이 1024 미만 포트에 바인딩하려면 이 권한이 필요하다.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# GC·safepoint 로그는 dev·prod 공통이다. JVM 이 5MB 마다 순환하며 파일 3개를 유지한다.
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=50.0 -Xlog:gc*,safepoint:file=/var/log/jachwi-sunbae/gc.log:time,uptime,level,tags:filecount=3,filesize=5M -jar /opt/jachwi-sunbae/app.jar
# 종료 이벤트 기록 실패가 애플리케이션의 종료 결과를 바꾸지 않도록 실패를 무시한다.
ExecStopPost=-/opt/jachwi-sunbae/scripts/log_service_exit.sh
WorkingDirectory=/opt/jachwi-sunbae

# Spring Boot는 SIGTERM 종료 시 143을 반환한다. 실패로 보지 않는다.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
