# 복사해서 .env로 사용한다. .env는 커밋하지 않는다.

# QA 대상 프론트엔드 URL. 비우면 DEV(https://dev.jachwi-sunbae.kr)를 사용한다.
QA_BASE_URL=

# AI 분석 대상: failed(기본, PASS가 아닌 Run만), always, off
QA_AI_ANALYSIS=

# AI 분석 모델 ID. 비우면 고정 기본값 claude-sonnet-5-5를 쓴다.
QA_AI_MODEL=

# 의도적으로 주입할 결함. 비우면 주입하지 않는다. 예: detail-rent, geocode-down
QA_FAULT=
